// -*- mode: jsonc -*-
[{
    "output": ["DP-1", "eDP-2"],
    "layer": "top", // Waybar at top layer
    "position": "top",
    "spacing": 5, // Gaps between modules (5px)
    "modules-left": ["group/workspaces", "cava", "hyprland/submap"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["group/system"],
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,

    "custom/split": {
      "format": "|",
      "tooltip": false
    },
    "custom/space": {
	"format": " ",
	"tooltip": false
    },

    "group/system": {
        "orientation": "horizontal",
        "modules": [
	    "mpris",
	    "custom/space",
	    "pulseaudio",
	    "custom/space", 
            "custom/notification",
            "idle_inhibitor", 
	    "memory",
	    "temperature",
	    "custom/split",	
            "clock",
	    "custom/split",
            "tray" 
        ]
    },

    "group/workspaces":{
        "orientation": "horizontal",
        "modules":[
            "hyprland/workspaces"
        ]
    },

    // --- HYPRLAND MODULES ---
    "hyprland/workspaces": {
        "all-outputs": true,
        "active-only": false,
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "format": "{icon}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5, 6, 8, 9, 10]
        },
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
	    "6": "",
	    "8": "󰹑",
            "9": "",
            "10": "",
            "urgent": "",
            "default": "",
	    "persistent": ""
        }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 60, // Mimicking your Sway setting of 60
        "separate-outputs": false // Mimicking Sway's "all-outputs": true behavior
    },
    "hyprland/submap": {
	"format": "{}",
	"max-length": 8,
	"tooltip": false
    },
   "cava": {
	"framerate": 60,
	"autosens": 1,
	"bars": 20,
	"lower_cutoff_freq": 50,
	"higher_cutoff_freq": 10000,
	"method": "pipewire",
	"source": "auto",
	"stereo": true,
	"reverse": false,
	"bar_delimiter": 0,
	"monstercat": false,
	"waves": false,
	"hide_on_silence": true,
	"noise_reduction": 0.77,
	"input_delay": 2,
	"format-icons": [" ", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
	"on-click-right": "pavucontrol"
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='red'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "mpris": {
 	"format": " {status_icon} {dynamic}",
        "interval": 1,
        "dynamic-len": 50,
	"status-icons": {"playing": "▶","paused": "⏸","stopped": ""},
	"dynamic-order": ["title", "artist"],
	"ignored-players": ["chromium"]
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        "icon-size": 14,
        "spacing": 14,
    },
    "clock": { 
    	"format": "{:%I:%M %p}",
    	"tooltip": false,
	"on-click": "kitty --class floating_notes -e nvim ~/.notes.md",
	"on-click-right": "wireshark"
    },
    "memory": {
        "format": " {}%",
	"tooltip": false,
	"on-click": "kitty -e btop",
	"on-click-right": "kitty sh -c 'fastfetch; exec bash'"
    }, 
    "temperature": {
    	"hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input", 
    	"critical-threshold": 80,
    	"format": " {temperatureC}°C",
    	"tooltip": false,
	"on-click": "GDK_BACKEND=x11 missioncenter",
	"on-click-right": "kitty -e nvtop" 
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}% ",
        "format-bluetooth-muted": "{icon} 󰂲",
        "format-muted": "",
        "format-icons": {
            "hands-free": "󰢳",
            "portable": "󰗜",
	    "phone": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    }
}]
